# Google Cloud target
GCP_PROJECT=
BQ_DATASET=aws_pricing
BQ_LOCATION=US
GCS_STAGING_BUCKET=
GCS_STAGING_PREFIX=ingestion/

# AWS Price List Bulk API
AWS_PRICING_BASE_URL=https://pricing.us-east-1.amazonaws.com
AWS_REQUEST_TIMEOUT_S=60
AWS_MAX_RETRIES=5

# Concurrent offer downloads. Each in-flight large offer (EC2/RDS us-east-1)
# costs ~500 MB peak memory (~200 MB tmpfs offer JSON + ~300 MB products dict
# in Python). 3 is sized for a 4 GiB Cloud Run instance; bump to 6-8 on 16 GiB.
AWS_MAX_WORKERS=3
# Concurrent region_index.json fetches during discovery — these responses are
# tiny (~10 KB), can stay aggressive without memory pressure.
AWS_DISCOVER_WORKERS=10

# Comma-separated AWS service codes to load (empty = all ~200 services).
# Use this for MVP / smoke tests, e.g. "AmazonEC2,AmazonRDS,AmazonS3".
AWS_SERVICE_FILTER=

# Toggle to also load the three Savings Plan offer trees (Compute / Database / ML).
AWS_INCLUDE_SAVINGS_PLANS=true

# Toggle to also flatten Reserved Instance terms in addition to OnDemand.
AWS_INCLUDE_RESERVED=true

# Outbound proxy (optional)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Loader behavior
JSONL_BATCH_SIZE=10000
LOG_LEVEL=INFO
