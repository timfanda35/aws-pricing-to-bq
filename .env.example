# Google Cloud target
GCP_PROJECT=
BQ_DATASET=aws_pricing
BQ_LOCATION=US
GCS_STAGING_BUCKET=
GCS_STAGING_PREFIX=ingestion/

# AWS Price List Bulk API
AWS_PRICING_BASE_URL=https://pricing.us-east-1.amazonaws.com
AWS_REQUEST_TIMEOUT_S=60
AWS_MAX_RETRIES=5
AWS_MAX_WORKERS=10

# Comma-separated AWS service codes to load (empty = all ~200 services).
# Use this for MVP / smoke tests, e.g. "AmazonEC2,AmazonRDS,AmazonS3".
AWS_SERVICE_FILTER=

# Toggle to also load the three Savings Plan offer trees (Compute / Database / ML).
AWS_INCLUDE_SAVINGS_PLANS=true

# Toggle to also flatten Reserved Instance terms in addition to OnDemand.
AWS_INCLUDE_RESERVED=true

# Outbound proxy (optional)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Loader behavior
JSONL_BATCH_SIZE=10000
LOG_LEVEL=INFO
